# Non-secret settings. `make env` copies these into .env and generates every secret
# (key passphrases, Airflow/Superset/Grafana admin passwords, Fernet/JWT keys).
# Never commit .env.
COMPOSE_PROJECT_NAME=lab1-weather
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_DATABASE=WEATHER_DB
SNOWFLAKE_WAREHOUSE=WEATHER_WH
AIRFLOW_ADMIN_USER=admin
AIRFLOW_PORT=8080
SUPERSET_ADMIN_USER=admin
SUPERSET_PORT=8088
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000
